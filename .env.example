# ===========================================
# WillTiboReset - 环境配置示例
# 复制此文件为 .env 并填入真实值
# ===========================================

# --- Twitter/X API (可选，当前不作为主要数据源) ---
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# --- OpenAI API (可选，用于后续 LLM 分析) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Gemini API (LLM 信号分析，优先使用) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- RSS Feed 配置 ---
# 逗号分隔的 RSS URL，不硬编码在代码中
TIBO_RSS_URLS=
OPENAI_RSS_URLS=
COMMUNITY_RSS_URLS=
# RSS 请求超时（秒）
RSS_REQUEST_TIMEOUT=30

# --- 预测模型配置 ---
# 预测时间窗口（小时），逗号分隔
PREDICTION_HORIZONS=5,24,48
# 置信度阈值 (0.0 - 1.0)，超过此值才报告"可能重置"
CONFIDENCE_THRESHOLD=0.5
# 无历史数据时的先验默认 reset 周期（小时）
DEFAULT_RESET_INTERVAL_HOURS=48
# 先验伪样本数，越大先验对平均周期的影响越强
INTERVAL_PRIOR_STRENGTH=1

# --- 数据路径 ---
DATA_DIR=data
OUTPUT_DIR=output
