# ===========================================
# WillTiboReset - Environment configuration example
# Copy this file to .env and fill in real values
# ===========================================

# --- Twitter/X API (optional, currently not used as a primary data source) ---
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# --- OpenAI API (optional, reserved for future LLM analysis) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Gemini API (deprecated, kept for compatibility) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- DeepSeek API (LLM signal analysis, currently preferred) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- RSS Feed configuration ---
# Comma-separated RSS URLs; not hard-coded in the codebase
TIBO_RSS_URLS=
OPENAI_RSS_URLS=
COMMUNITY_RSS_URLS=
# RSS request timeout (seconds)
RSS_REQUEST_TIMEOUT=30

# --- Prediction model configuration ---
# Prediction time windows in hours, comma-separated
PREDICTION_HORIZONS=5,24,48
# Confidence threshold (0.0 - 1.0); "likely reset" is reported only above this value
CONFIDENCE_THRESHOLD=0.5
# Default prior reset interval in hours when no historical data exists
DEFAULT_RESET_INTERVAL_HOURS=48
# Prior pseudo-sample count; larger values make the prior exert stronger influence on the average interval
INTERVAL_PRIOR_STRENGTH=1

# --- Development / test configuration ---
# When set to true, CommunityCollector loads data/sample_tweets.json
# Must be left empty or set to false in production
USE_MOCK_DATA=false

# --- Data paths ---
DATA_DIR=data
OUTPUT_DIR=output
