# ===========================================
# WillTiboReset - 环境配置示例
# 复制此文件为 .env 并填入真实值
# ===========================================

# --- Twitter/X API ---
# 用于收集 Tibo/OpenAI 相关推文
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# --- OpenAI API (用于 LLM 分析) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- 预测模型配置 ---
# 预测时间窗口（小时），逗号分隔
PREDICTION_HORIZONS=5,24,48
# 置信度阈值 (0.0 - 1.0)，超过此值才报告"可能重置"
CONFIDENCE_THRESHOLD=0.5

# --- 数据路径 ---
DATA_DIR=data
OUTPUT_DIR=output
